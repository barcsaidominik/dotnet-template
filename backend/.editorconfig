root = true

[*]
end_of_line = crlf
charset = utf-8
insert_final_newline = true

[*.cs]

# Namespace és using
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Block body / braces
csharp_style_expression_bodied_methods = false:error
csharp_style_expression_bodied_local_functions = false:error
csharp_prefer_braces = true:error

# var használat
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error

# Inicializálók / readonly
dotnet_style_object_initializer = true:error
dotnet_style_collection_initializer = true:error
dotnet_style_readonly_field = true:error

# Null-check / pattern matching
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error
csharp_style_pattern_matching_over_is_with_cast_check = true:error
csharp_style_pattern_matching_over_as_with_null_check = true:error
csharp_style_prefer_switch_expression = true:error

# this. kvalifikáció
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error

# Primary constructor preferencia
csharp_style_prefer_primary_constructors = true
dotnet_diagnostic.IDE0290.severity = warning

# Modifier sorrend
csharp_preferred_modifier_order = public, private, protected, internal, file, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, required, volatile, async:error

# Newline / indent / spacing
csharp_new_line_before_open_brace = types, methods, properties, accessors, anonymous_methods, control_blocks, anonymous_types, object_collection_array_initializers, lambdas, local_functions
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false

# Naming szabályok
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_symbols.interfaces.required_modifiers = 

dotnet_naming_style.interface_prefix_i.required_prefix = I
dotnet_naming_style.interface_prefix_i.capitalization = pascal_case

dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = interface_prefix_i
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = error

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = 

dotnet_naming_style.private_field_underscore_camel.required_prefix = _
dotnet_naming_style.private_field_underscore_camel.capitalization = camel_case

dotnet_naming_rule.private_fields_should_be_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel.style = private_field_underscore_camel
dotnet_naming_rule.private_fields_should_be_underscore_camel.severity = error

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_style.constants_should_be_upper_snake_case.capitalization = all_upper
dotnet_naming_style.constants_should_be_upper_snake_case.word_separator = _

dotnet_naming_rule.constants_should_be_upper_snake_case.symbols = constants
dotnet_naming_rule.constants_should_be_upper_snake_case.style = constants_should_be_upper_snake_case
dotnet_naming_rule.constants_should_be_upper_snake_case.severity = error

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_symbols.types.required_modifiers = 

dotnet_naming_style.types_should_be_pascal_case.capitalization = pascal_case

dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = types_should_be_pascal_case
dotnet_naming_rule.types_should_be_pascal_case.severity = error

# Analyzer szintek
dotnet_diagnostic.IDE0161.severity = error
dotnet_diagnostic.IDE0022.severity = error
dotnet_diagnostic.IDE0011.severity = error
dotnet_diagnostic.IDE0008.severity = error
dotnet_diagnostic.IDE0007.severity = error
dotnet_diagnostic.IDE0044.severity = error
dotnet_diagnostic.IDE0028.severity = error
dotnet_diagnostic.IDE0300.severity = error
dotnet_diagnostic.IDE0041.severity = error
dotnet_diagnostic.IDE0017.severity = error
dotnet_diagnostic.IDE0055.severity = error
dotnet_diagnostic.IDE0066.severity = error
dotnet_diagnostic.IDE1006.severity = error
