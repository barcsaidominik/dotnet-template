{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "products": {
        "ClusterId": "products-api",
        "Order": 0,
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "default": {
        "ClusterId": "core-api",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "products-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7135/"
          }
        }
      },
      "core-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5281/"
          }
        }
      }
    }
  }
}
