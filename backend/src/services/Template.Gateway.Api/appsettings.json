{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Elastic.Serilog.Sinks" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "<{SyslogPriority}>1 {Timestamp:yyyy-MM-ddTHH:mm:ss.fffZ} {MachineName} Template - - - [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "ReverseProxy": {
    "Routes": {
      "products": {
        "ClusterId": "products-api",
        "Order": 0,
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "default": {
        "ClusterId": "core-api",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "products-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7135/"
          }
        }
      },
      "core-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5281/"
          }
        }
      }
    }
  }
}
