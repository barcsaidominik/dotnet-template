{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "JwtSettings": {
    "Secret": "FzfpZ91x5bHE1e98G6z7T38V132H3v0P",
    "Issuer": "template-api",
    "Audience": "template-clients",
    "ExpiryMinutes": 15
  },
  "InternalServiceAuth": {
    "Token": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Elastic.Serilog.Sinks" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "<{SyslogPriority}>1 {Timestamp:yyyy-MM-ddTHH:mm:ss.fffZ} {MachineName} Template - - - [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
