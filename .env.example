TEMPLATE_DB_USER=postgres
TEMPLATE_DB_PASSWORD=postgres
TEMPLATE_DB_NAME=template_db
TEMPLATE_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TEMPLATE_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-service-token

# Alternatively, use Docker secrets (see secrets.example/)
# JWT_SECRET and INTERNAL_SERVICE_TOKEN can be provided via /run/secrets/jwt_secret etc.
# Docker secrets take precedence over environment variables when both are present.
