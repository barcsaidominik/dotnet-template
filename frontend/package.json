{
  "name": "template-frontend",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.{ts,html}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\" \"*.{json,js,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\" \"*.{json,js,md}\"",
    "style:check": "npm run format:check && npm run lint",
    "generate:types": "openapi-typescript ../backend/Api.json -o src/app/generated/api.types.ts",
    "generate:client": "ng-openapi-gen --config ng-openapi-gen.json",
    "generate:types:products": "openapi-typescript ../backend/ProductsApi.json -o src/app/generated/products.api.types.ts",
    "generate:products": "npm run generate:types:products && ng-openapi-gen --config ng-openapi-gen-products.json",
    "generate:api": "npm run generate:types && npm run generate:client && npm run generate:products",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@angular/animations": "^21.2.11",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.11",
    "@angular/compiler": "^21.2.11",
    "@angular/core": "^21.2.11",
    "@angular/forms": "^21.2.11",
    "@angular/material": "^21.2.9",
    "@angular/platform-browser": "^21.2.11",
    "@angular/platform-browser-dynamic": "^21.2.11",
    "@angular/router": "^21.2.11",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.11",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "angular-eslint": "^21.3.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "ng-openapi-gen": "^1.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{scss,css,json,js,md}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx --prefix frontend lint-staged --cwd frontend"
  }
}
